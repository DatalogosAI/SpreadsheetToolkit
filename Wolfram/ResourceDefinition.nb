Cell[TextData[{
 "A very complex trace as a ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["ConditionalExpression", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/ConditionalExpression",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e0a81c00-4d0d-4f2d-a89f-0567949c8b34"],
 " in terms of sub-traces:"
}], "Text",
