Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"\<\"A1+B1\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\<\"A1\"\>", ",", "\<\"B1\"\>"}], "}"}]}]},
    {
     RowBox[{"\<\"C1*2\"\>", "\[Rule]", 
      RowBox[{"{", "\<\"C1\"\>", "}"}]}]},
    {
     RowBox[{"\<\"D1+A1\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\<\"D1\"\>", ",", "\<\"A1\"\>"}], "}"}]}]},
    {
     RowBox[{"\<\"A3^2\"\>", "\[Rule]", 
      RowBox[{"{", "\<\"A3\"\>", "}"}]}]},
