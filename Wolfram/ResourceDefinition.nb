     RowBox[{"\<\"B3-A3\"\>", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\<\"B3\"\>", ",", "\<\"A3\"\>"}], "}"}]}]},
    {
     RowBox[{"\<\"LEN(A5)\"\>", "\[Rule]", 
      RowBox[{"{", "\<\"A5\"\>", "}"}]}]},
    {
     RowBox[{"\<\"B5+1\"\>", "\[Rule]", 
      RowBox[{"{", "\<\"B5\"\>", "}"}]}]}
   },
